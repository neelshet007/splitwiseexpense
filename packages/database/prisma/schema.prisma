datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String
  passwordHash         String
  telegramChatId       String?   @unique
  telegramUsername     String?
  telegramConnected    Boolean   @default(false)
  telegramConnectedAt  DateTime?
  notifyExpenseAdded   Boolean   @default(true)
  notifyMonthlySummary Boolean   @default(true)
  notifySettlements    Boolean   @default(true)
  notifyPasswordReset  Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relationships
  groupMemberships     GroupMember[]
  createdGroups        Group[]                 @relation("GroupCreator")
  createdTrips         Trip[]                  @relation("TripCreator")
  tripMemberships      TripMember[]            @relation("TripMemberships")
  expensesPaid         Expense[]               @relation("ExpensePayer")
  expensesCreated      Expense[]               @relation("ExpenseCreator")
  expenseSplits        ExpenseSplit[]
  passwordResets       PasswordReset[]
  telegramTokens       TelegramConnectToken[]
  friendshipsRequested Friendship[]            @relation("FriendshipRequester")
  friendshipsReceived  Friendship[]            @relation("FriendshipReceiver")
  settlementsPaid      Settlement[]            @relation("SettlementPayer")
  settlementsReceived  Settlement[]            @relation("SettlementReceiver")
  tripSettlementsPaid  TripSettlement[]        @relation("TripSettlementPayer")
  tripSettlementsReceived TripSettlement[]     @relation("TripSettlementReceiver")
  notificationLogs     NotificationLog[]

  @@index([email])
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User     @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status      String   @default("ACCEPTED") // PENDING | ACCEPTED | REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requesterId, receiverId])
  @@index([requesterId])
  @@index([receiverId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model TelegramConnectToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model NotificationLog {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // MONTHLY_SUMMARY | EXPENSE_ADDED | SETTLEMENT | PASSWORD_RESET
  period    String?   // e.g. "2026-10"
  status    String    // PENDING | SENT | FAILED
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, type, period])
  @@index([userId])
}

model Group {
  id          String   @id @default(cuid())
  name        String
  inviteCode  String   @unique @default(cuid())
  createdBy   String
  creator     User     @relation("GroupCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     GroupMember[]
  expenses    Expense[]
  summaries   MonthlySummaryLog[]

  @@index([createdBy])
  @@index([inviteCode])
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model Expense {
  id          String         @id @default(cuid())
  groupId     String?        // Nullable: null indicates direct 1-to-1 friend expense or trip expense
  group       Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tripId      String?        // Nullable: set if this expense belongs to a Trip
  trip        Trip?          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  description String
  totalAmount Int            // Integer minor units (e.g., paise/cents: 120000 = ₹1,200.00)
  splitType   String         @default("EQUAL") // EQUAL | EXACT | PERCENTAGE | FULL_AMOUNT
  paidBy      String
  payer       User           @relation("ExpensePayer", fields: [paidBy], references: [id], onDelete: Restrict)
  createdBy   String
  creator     User           @relation("ExpenseCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  expenseDate DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  splits      ExpenseSplit[]

  @@index([groupId, expenseDate(sort: Desc)])
  @@index([tripId, expenseDate(sort: Desc)])
  @@index([paidBy])
  @@index([groupId])
  @@index([tripId])
  @@index([createdBy])
}

model ExpenseSplit {
  id         String   @id @default(cuid())
  expenseId  String
  expense    Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountOwed Int      // Minor units (paise/cents)

  @@unique([expenseId, userId])
  @@index([expenseId])
  @@index([userId])
}

model MonthlySummaryLog {
  id         String   @id @default(cuid())
  groupId    String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  yearMonth  String   // e.g. "2026-10"
  executedAt DateTime @default(now())

  @@unique([groupId, yearMonth])
  @@index([groupId])
}

model Settlement {
  id         String   @id @default(cuid())
  fromUserId String
  fromUser   User     @relation("SettlementPayer", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("SettlementReceiver", fields: [toUserId], references: [id], onDelete: Cascade)
  amount     Int      // Integer minor units (paise/cents)
  settledAt  DateTime @default(now())
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([fromUserId])
  @@index([toUserId])
  @@index([settledAt(sort: Desc)])
}

model Trip {
  id          String           @id @default(cuid())
  name        String
  description String?
  inviteCode  String           @unique
  isArchived  Boolean          @default(false)
  createdBy   String
  creator     User             @relation("TripCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  members     TripMember[]
  expenses    Expense[]
  settlements TripSettlement[]

  @@index([createdBy])
  @@index([inviteCode])
}

model TripMember {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("TripMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // ADMIN | MEMBER
  joinedAt  DateTime @default(now())

  @@unique([tripId, userId])
  @@index([tripId])
  @@index([userId])
}

model TripSettlement {
  id         String   @id @default(cuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User     @relation("TripSettlementPayer", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("TripSettlementReceiver", fields: [toUserId], references: [id], onDelete: Cascade)
  amount     Int      // Integer minor units (paise/cents)
  settledAt  DateTime @default(now())
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tripId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([settledAt(sort: Desc)])
}


